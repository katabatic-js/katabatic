<script type="module">
    import { effect } from '@katabatic/signals'
    import { increment } from './increment.js'

    export class Binding extends HTMLElement {
        value = 10
    }

    customElements.define('ex-binding', Binding)
</script>

<template>
    <div
        :use="{increment()}"
        :value="{value}"
        :onincrement="{value = event.target.value}">
        {value}
    </div>
</template>
