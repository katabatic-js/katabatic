<script type="module">
    import * as List from './list.js'

    class ExItem extends HTMLElement {
        static observedAttributes = ['color']

        item

        connectedCallback() {
            console.log('ExItem connected:', this.item.name)
        }

        disconnectedCallback() {
            console.log('ExItem disconnected:', this.item.name)
        }

        connectedMoveCallback() {
            console.log('ExItem moved:', this.item.name)
        }
    }
</script>

<template>
    <li style="{`--color: ${getAttribute('color')}`}">
        <span>{item.name}</span>
        <button onclick="{List.up(item)}">up</button>
        <button onclick="{List.down(item)}">down</button>
        <button onclick="{List.remove(item)}">remove</button>
    </li>
    <style>
        li {
            display: flex;
            gap: 0.5rem;
            min-width: 400px;
            padding: 1rem;
            margin-bottom: 1rem;
            background-color: var(--color);
        }

        span {
            flex: 1;
        }
    </style>
</template>
